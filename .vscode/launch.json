{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CRM API (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "CRM: Build API",
      "program": "${workspaceFolder}/backend/src/Crm.Api/bin/Debug/net10.0/Crm.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Crm.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5290"
      },
      "stopAtEntry": false
    }
  ]
}
